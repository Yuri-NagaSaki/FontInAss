# FontInAss Local — Docker environment variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# Authentication key for font management endpoints
# Leave empty for open access (not recommended for production)
API_KEY=change-me-to-a-strong-secret

# CORS origin (set to your domain in production)
CORS_ORIGIN=*

# Local data paths (also used by one-time v2 rebuild scripts)
FONT_DIR=./fonts
DB_PATH=./data/fontinass-v2.db
PENDING_DIR=./data/pending-v2
LOG_DIR=./data/logs

# Subsetting concurrency
SUBSET_CONCURRENCY=5
CACHE_MAX_ENTRIES=500

# Upload/index maintenance
UPLOAD_TARGET_DIR=CatCat-Fonts/
PUBLIC_UPLOAD_MAX_FILES=20
PUBLIC_UPLOAD_MAX_FILE_SIZE=104857600
PUBLIC_UPLOAD_MAX_BATCH_SIZE=209715200
PUBLIC_UPLOAD_REQUESTS_PER_MINUTE=30
TOKEN_APPLICATION_DAILY_LIMIT=3
AUTO_INDEX_INTERVAL_HOURS=4

# Log level
LOG_LEVEL=info

# ─── R2 Sharing (optional — required for subtitle sharing feature) ─────────
# Cloudflare R2 credentials for subtitle archive storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Sharing settings
SHARING_MAX_FILE_SIZE=209715200
SHARING_RATE_LIMIT=3
ARCHIVE_MAX_UNCOMPRESSED=2147483648
