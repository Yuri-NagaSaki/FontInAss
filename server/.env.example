# Server settings
PORT=3000

# Security — set a strong random key (required for font management endpoints)
API_KEY=change-me-to-a-strong-secret

# Paths (relative to server/ directory or absolute)
FONT_DIR=./fonts
DB_PATH=./data/fontinass-v2.db
PENDING_DIR=./data/pending-v2
LOG_DIR=./data/logs

# CORS — set to your frontend origin in production
# Example: CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=*

# Subsetting concurrency (max fonts processed simultaneously per request)
SUBSET_CONCURRENCY=5

# In-memory result cache (number of processed subtitle results to keep in RAM)
CACHE_MAX_ENTRIES=500

# Public/API font uploads are stored below this font directory prefix
UPLOAD_TARGET_DIR=CatCat-Fonts/
PUBLIC_UPLOAD_MAX_FILES=20
PUBLIC_UPLOAD_MAX_FILE_SIZE=104857600
PUBLIC_UPLOAD_MAX_BATCH_SIZE=209715200
PUBLIC_UPLOAD_REQUESTS_PER_MINUTE=30
TOKEN_APPLICATION_DAILY_LIMIT=3

# Archive safety limit (uncompressed bytes)
ARCHIVE_MAX_UNCOMPRESSED=2147483648
SHARING_MAX_FILE_SIZE=209715200
SHARING_RATE_LIMIT=3

# Automatic font index maintenance
AUTO_INDEX_INTERVAL_HOURS=4

# Cloudflare R2 (required for the archive sharing library)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Log level: error | warn | info | debug
LOG_LEVEL=info
