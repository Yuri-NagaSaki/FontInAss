# Run from server/. Production values belong in the deployment secret store.
NODE_ENV=development
PORT=3000
FONTINASS_PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

FONTINASS_OPERATOR_CREDENTIAL=replace-with-a-random-operator-credential-at-least-32-chars

FONTINASS_OIDC_ISSUER=https://oauth.anibt.net
FONTINASS_OIDC_CLIENT_ID=replace-with-fontinass-client-id
FONTINASS_OIDC_CLIENT_SECRET=replace-with-a-random-client-secret-at-least-32-chars
FONTINASS_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
FONTINASS_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
FONTINASS_OIDC_SCOPES=openid profile anibt:user_id
FONTINASS_OIDC_TIMEOUT_MS=8000

FONTINASS_ENTITLEMENT_ORIGIN=https://anibt.net
FONTINASS_ENTITLEMENT_KEY_ID=fontinass-development-entitlement
FONTINASS_ENTITLEMENT_SIGNING_SECRET=replace-with-a-random-entitlement-secret-at-least-32-chars
FONTINASS_ENTITLEMENT_TIMEOUT_MS=5000

FONTINASS_SESSION_FINGERPRINT_SECRET=replace-with-a-random-fingerprint-secret-at-least-32-chars
FONTINASS_SESSION_ENCRYPTION_KEY=replace-with-a-random-encryption-secret-at-least-32-chars
FONTINASS_LOGIN_TRANSACTION_TTL_MS=600000
FONTINASS_SESSION_IDLE_TTL_MS=43200000
FONTINASS_SESSION_ABSOLUTE_TTL_MS=604800000
FONTINASS_RECENT_AUTH_TTL_MS=600000
FONTINASS_CREDENTIALS_PER_USER=5
FONTINASS_CREDENTIALS_PER_ORGANIZATION=25
FONTINASS_CREDENTIAL_CREATIONS_PER_HOUR=10
FONTINASS_CREDENTIAL_MAX_TTL_MS=31536000000

FONT_DIR=./fonts
DB_PATH=./data/fontinass-v2.db
PENDING_DIR=./data/pending-v2
LOG_DIR=./data/logs
SUBSET_CONCURRENCY=5
CACHE_MAX_ENTRIES=500
UPLOAD_TARGET_DIR=CatCat-Fonts/
PUBLIC_UPLOAD_MAX_FILES=20
PUBLIC_UPLOAD_MAX_FILE_SIZE=104857600
PUBLIC_UPLOAD_MAX_BATCH_SIZE=209715200
PUBLIC_UPLOAD_REQUESTS_PER_MINUTE=30
ARCHIVE_MAX_UNCOMPRESSED=2147483648
SHARING_MAX_FILE_SIZE=209715200
SHARING_RATE_LIMIT=3
AUTO_INDEX_INTERVAL_HOURS=4
LOG_LEVEL=info

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
