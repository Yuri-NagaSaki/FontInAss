{
  "name": "@fontinass/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external"
  },
  "dependencies": {
    "@fontinass/access-control": "workspace:*",
    "@fontinass/activity-log": "workspace:*",
    "@fontinass/archive-library": "workspace:*",
    "@fontinass/contracts": "workspace:*",
    "@fontinass/font-catalog": "workspace:*",
    "@fontinass/font-submission": "workspace:*",
    "@fontinass/persistence": "workspace:*",
    "@fontinass/storage": "workspace:*",
    "@fontinass/subtitle-processing": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.7.10",
    "opentype.js": "^1.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "typescript": "^5.8.2"
  }
}
